APP_NAME=SchoolTool
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=127.0.0.1

CACHE_STORE=array
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8001,localhost:8001

MAIL_MAILER=log
TEACHING_ACTIVE=true
