FILESYSTEM_DISK=local
FILESYSTEM_DISK_LOCAL=local
QUEUE_CONNECTION=redis
DB_QUEUE_RETRY_AFTER=1860
BEANSTALKD_QUEUE_RETRY_AFTER=1860
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=1860

HORIZON_NAME="${APP_NAME}"
HORIZON_PATH=horizon

PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database
PULSE_STORAGE_KEEP="7 days"
PULSE_INGEST_DRIVER=storage
PULSE_SERVERS_ENABLED=false
PULSE_USER_JOBS_ENABLED=false
PULSE_USER_REQUESTS_ENABLED=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_INTEGRATION_URL=null
