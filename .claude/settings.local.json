{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Glob",
      "Grep",
      "TodoWrite",
      "Bash",
      "PowerShell(*)",
      "mcp__laravel-boost__search-docs",
      "mcp__laravel-boost__list-routes",
