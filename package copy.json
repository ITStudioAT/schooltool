{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "ide-helper": "php artisan ide-helper:generate && php artisan ide-helper:meta",
        "preview": "vite preview",
        "test:all": "composer test && npm run test:ui && npm run test:e2e",
        "test:ui": "vitest run",
        "test:ui:watch": "vitest",
        "pretest:e2e": "npm run build && php -r \"if (!file_exists('.env.e2e')) { fwrite(STDERR, '.env.e2e is missing. Copy .env.e2e.example to .env.e2e first.' . PHP_EOL); exit(1); } if (!file_exists('database/e2e.sqlite')) { touch('database/e2e.sqlite'); }\" && php artisan migrate:fresh --env=e2e --seed --seeder=E2eSeeder --force",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@laravel/echo-vue": "^2.2.6",
        "@pinia/testing": "^1.0.3",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/vue": "^8.1.0",
        "@vue/test-utils": "^2.4.6",
        "axios": "^1.12.2",
        "concurrently": "^9.0.1",
        "happy-dom": "^20.6.1",
        "laravel-echo": "^2.2.6",
        "laravel-vite-plugin": "^2.0.0",
        "msw": "^2.12.10",
        "pusher-js": "^8.4.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.0",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "@tiptap/extension-underline": "^3.15.3",
        "@tiptap/starter-kit": "^3.15.3",
        "@tiptap/vue-3": "^3.15.3",
        "@vitejs/plugin-vue": "^6.0.1",
        "filepond": "^4.32.10",
        "filepond-plugin-file-validate-type": "^1.2.9",
        "filepond-plugin-image-preview": "^4.6.12",
        "pinia": "^3.0.3",
        "puppeteer": "^24.29.1",
        "sass-embedded": "^1.93.2",
        "vite-plugin-vuetify": "^2.1.2",
        "vue": "^3.5.22",
        "vue-filepond": "^7.0.4",
        "vue-router": "^4.6.3",
        "vuetify": "^3.10.5"
    }
}
