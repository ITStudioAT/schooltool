{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "devrabiul/laravel-cookie-consent": "^1.1",
        "doctrine/dbal": "^4.4",
        "google/cloud-document-ai": "^2.6",
        "intervention/image": "^3.11",
        "lab404/laravel-impersonate": "^1.7.8",
        "laravel/ai": "^0.3.2",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3.1",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.31",
        "phpoffice/phppresentation": "dev-master",
        "phpoffice/phpspreadsheet": "^5.7",
        "phpoffice/phpword": "^1.4",
        "predis/predis": "^3.3",
        "pusher/pusher-php-server": "^7.2",
        "shipfastlabs/parsel": "^0.0.3",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-pdf": "^2.4",
        "spatie/laravel-permission": "^6.25",
        "spatie/pdf-to-text": "^1.54",
        "spatie/simple-excel": "^3.9",
        "symfony/http-client": "^7.3",
        "symfony/postmark-mailer": "^7.3"
    },
    "require-dev": {
        "andreapollastri/checkpoint": "^1.0",
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "fruitcake/laravel-debugbar": "^4.1.3",
        "laravel/boost": "^2.3.4",
        "laravel/pail": "^1.2.6",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.54",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.1",
        "pestphp/pest": "^4.4.2",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1.0",
        "spatie/guidelines-skills": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "deploy": [
            "Composer\\Config::disableProcessTimeout",
            "bash scripts/deploy_cloudways.sh"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan app:update --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact"
        ],
        "test:php": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact"
        ],
        "test:php:smoke": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/SchooltoolConfigTest.php tests/Unit/SanctumConfigTest.php tests/Feature/DatabaseSafetyTest.php"
        ],
        "test:php:config": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/SchooltoolConfigTest.php tests/Unit/SanctumConfigTest.php"
        ],
        "test:php:safety": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Feature/DatabaseSafetyTest.php"
        ],
        "test:php:import116": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/Import116ServiceTest.php"
        ],
        "test:php:install-update": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/InstallUpdateServiceTest.php"
        ],
        "test:php:models": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/ModelsTest.php"
        ],
        "test:php:access": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/ApiAllowedTest.php tests/Unit/WebAllowedTest.php tests/Unit/ToolLicensedMiddlewareTest.php tests/Unit/AccessScopeServiceTest.php tests/Unit/AdminNavigationServiceTest.php tests/Unit/HomepageRoutingServiceTest.php tests/Unit/CorsConfigTest.php"
        ],
        "test:php:auth-users": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/AuthServiceTest.php tests/Unit/UserServiceTest.php tests/Unit/RegisterUserServiceTest.php tests/Unit/Traits/UserTraitTest.php tests/Feature/Services/UserServiceTest.php tests/Feature/UserControllerTest.php tests/Feature/UserWithRoleControllerTest.php tests/Feature/UserHopperAccountControllerTest.php"
        ],
        "test:php:register-services": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/RegisterServiceTest.php tests/Unit/RegisterDateServiceTest.php tests/Unit/RegisterDateBookingServiceTest.php tests/Unit/RegisterUserServiceTest.php tests/Unit/RegisterTestRecordsServiceTest.php"
        ],
        "test:php:register-admin": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Feature/RegisterControllerTest.php tests/Feature/RegisterDateControllerTest.php tests/Feature/RegisterDateBookingControllerTest.php tests/Feature/RegisterUserControllerTest.php"
        ],
        "test:php:register-homepage": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Feature/Controllers/Homepage/RegisterControllerTest.php"
        ],
        "test:php:register-print": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/PrintRegisterServiceTest.php tests/Unit/PrintRegisterDateJobTest.php tests/Unit/PrintRegisterExcelJobTest.php tests/Unit/PrintRegisterSupervisorJobTest.php tests/Feature/RegisterPrintControllerTest.php"
        ],
        "test:php:register-requests": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Feature/Requests/Admin/RegisterRequestsTest.php tests/Feature/Requests/Admin/RegisterDateRequestsTest.php tests/Feature/Requests/Homepage/RegisterRequestsTest.php"
        ],
        "test:php:register-command": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Feature/Console/MakeRegisterTestRecordsCommandTest.php"
        ],
        "test:php:tutoring-admin": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/SubjectServiceTest.php tests/Unit/TutoringOfferServiceTest.php tests/Unit/TutoringServiceTest.php tests/Unit/TutoringTestDataSmallSeederTest.php tests/Feature/Controllers/Admin/Tutoring/OfferControllerTest.php tests/Feature/Controllers/Admin/Tutoring/SubjectControllerTest.php tests/Feature/Controllers/Admin/Tutoring/UserControllerTest.php"
        ],
        "test:php:tutoring-public": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Feature/TutoringControllerTest.php tests/Feature/TutoringSubjectControllerTest.php tests/Feature/TutoringUserControllerTest.php tests/Feature/Controllers/Tutoring/OfferControllerTest.php tests/Feature/Controllers/Tutoring/OfferRequestControllerTest.php tests/Feature/Controllers/Tutoring/SubjectControllerTest.php tests/Feature/Controllers/Tutoring/UserControllerTest.php"
        ],
        "test:php:resources": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/Resources/AdminResourcesTest.php tests/Unit/Resources/HomepageResourcesTest.php tests/Unit/Resources/TutoringResourcesTest.php"
        ],
        "test:php:requests": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Feature/Requests/Admin/AuthRequestsTest.php tests/Feature/Requests/Admin/UserRequestsTest.php tests/Feature/Requests/Admin/RoleRequestsTest.php tests/Feature/Requests/Admin/SchoolRequestsTest.php tests/Feature/Requests/Admin/SchoolyearRequestsTest.php tests/Feature/Requests/Admin/SecurityRequestsTest.php tests/Feature/Requests/Admin/LicenceRequestsTest.php tests/Feature/Requests/Admin/RegisterRequestsTest.php tests/Feature/Requests/Admin/RegisterDateRequestsTest.php tests/Feature/Requests/Homepage/RegisterRequestsTest.php tests/Feature/Requests/Homepage/TutoringRequestsTest.php tests/Feature/Requests/Tutoring/TutoringRequestsTest.php"
        ],
        "check:encoding": [
            "@php scripts/check-encoding.php"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
