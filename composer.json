{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "devrabiul/laravel-cookie-consent": "^1.1",
        "doctrine/dbal": "^4.4",
        "google/cloud-document-ai": "^2.6",
        "intervention/image": "^3.11",
        "itstudioat/spa": "^0.3.3",
        "lab404/laravel-impersonate": "^1.7.8",
        "laravel/ai": "^0.3.2",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.31",
        "phpoffice/phppresentation": "^1.2",
        "phpoffice/phpspreadsheet": "^4.5",
        "phpoffice/phpword": "^1.4",
        "predis/predis": "^3.3",
        "pusher/pusher-php-server": "^7.2",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-pdf": "^2.4",
        "spatie/pdf-to-text": "^1.54",
        "spatie/simple-excel": "^3.9",
        "symfony/http-client": "^7.3",
        "symfony/postmark-mailer": "^7.3"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "fruitcake/laravel-debugbar": "^4.1.3",
        "laravel/boost": "^2.3.4",
        "laravel/pail": "^1.2.6",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.54",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.1",
        "pestphp/pest": "^4.4.2",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1.0",
        "spatie/guidelines-skills": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": [
            "vendor/itstudioat/spa/src/Facades/Spa.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "bootstrap/itstudioat-spa-moved",
            "options": {
                "symlink": false
            }
        }
    ],
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan app:update --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "check:encoding": [
            "@php scripts/check-encoding.php"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {
                "GHSA-rx7m-68vc-ppxh": "Temporary: required by PHPPresentation; remove/upgrade when compatible."
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
