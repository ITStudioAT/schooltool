{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node --max-old-space-size=2048 ./node_modules/vite/bin/vite.js build",
        "dev": "vite",
        "generate:wayfinder": "php artisan wayfinder:generate --no-interaction",
        "ide-helper": "php artisan ide-helper:generate && php artisan ide-helper:meta",
        "preview": "vite preview",
        "test:php": "php -d memory_limit=1024M artisan test --compact",
        "test:php:smoke": "php -d memory_limit=1024M artisan test --compact tests/Unit/SchooltoolConfigTest.php tests/Unit/SanctumConfigTest.php tests/Feature/DatabaseSafetyTest.php",
        "test:php:config": "php -d memory_limit=1024M artisan test --compact tests/Unit/SchooltoolConfigTest.php tests/Unit/SanctumConfigTest.php",
        "test:php:safety": "php -d memory_limit=1024M artisan test --compact tests/Feature/DatabaseSafetyTest.php",
        "test:php:import116": "php -d memory_limit=1024M artisan test --compact tests/Unit/Import116ServiceTest.php",
        "test:php:install-update": "php -d memory_limit=1024M artisan test --compact tests/Unit/InstallUpdateServiceTest.php",
        "test:php:models": "php -d memory_limit=1024M artisan test --compact tests/Unit/ModelsTest.php",
        "test:php:access": "php -d memory_limit=1024M artisan test --compact tests/Unit/ApiAllowedTest.php tests/Unit/WebAllowedTest.php tests/Unit/ToolLicensedMiddlewareTest.php tests/Unit/AccessScopeServiceTest.php tests/Unit/AdminNavigationServiceTest.php tests/Unit/HomepageRoutingServiceTest.php tests/Unit/CorsConfigTest.php",
        "test:php:auth-users": "php -d memory_limit=1024M artisan test --compact tests/Unit/AuthServiceTest.php tests/Unit/UserServiceTest.php tests/Unit/RegisterUserServiceTest.php tests/Unit/Traits/UserTraitTest.php tests/Feature/Services/UserServiceTest.php tests/Feature/UserControllerTest.php tests/Feature/UserWithRoleControllerTest.php tests/Feature/UserHopperAccountControllerTest.php",
        "test:php:register-services": "php -d memory_limit=1024M artisan test --compact tests/Unit/RegisterServiceTest.php tests/Unit/RegisterDateServiceTest.php tests/Unit/RegisterDateBookingServiceTest.php tests/Unit/RegisterUserServiceTest.php tests/Unit/RegisterTestRecordsServiceTest.php",
        "test:php:register-admin": "php -d memory_limit=1024M artisan test --compact tests/Feature/RegisterControllerTest.php tests/Feature/RegisterDateControllerTest.php tests/Feature/RegisterDateBookingControllerTest.php tests/Feature/RegisterUserControllerTest.php",
        "test:php:register-homepage": "php -d memory_limit=1024M artisan test --compact tests/Feature/Controllers/Homepage/RegisterControllerTest.php",
        "test:php:register-print": "php -d memory_limit=1024M artisan test --compact tests/Unit/PrintRegisterServiceTest.php tests/Unit/PrintRegisterDateJobTest.php tests/Unit/PrintRegisterExcelJobTest.php tests/Unit/PrintRegisterSupervisorJobTest.php tests/Feature/RegisterPrintControllerTest.php",
        "test:php:register-requests": "php -d memory_limit=1024M artisan test --compact tests/Feature/Requests/Admin/RegisterRequestsTest.php tests/Feature/Requests/Admin/RegisterDateRequestsTest.php tests/Feature/Requests/Homepage/RegisterRequestsTest.php",
        "test:php:register-command": "php -d memory_limit=1024M artisan test --compact tests/Feature/Console/MakeRegisterTestRecordsCommandTest.php",
        "test:php:module-removal": "php -d memory_limit=1024M artisan test --compact tests/Feature/TutoringRemovalMigrationTest.php tests/Feature/TutoringControllerTest.php tests/Feature/TutoringOwnershipAuthorizationTest.php",
        "test:php:resources": "php -d memory_limit=1024M artisan test --compact tests/Unit/Resources/AdminResourcesTest.php tests/Unit/Resources/HomepageResourcesTest.php tests/Unit/Resources/TutoringResourcesTest.php",
        "test:php:requests": "php -d memory_limit=1024M artisan test --compact tests/Feature/Requests/Admin/AuthRequestsTest.php tests/Feature/Requests/Admin/UserRequestsTest.php tests/Feature/Requests/Admin/RoleRequestsTest.php tests/Feature/Requests/Admin/SchoolRequestsTest.php tests/Feature/Requests/Admin/SchoolyearRequestsTest.php tests/Feature/Requests/Admin/SecurityRequestsTest.php tests/Feature/Requests/Admin/LicenceRequestsTest.php tests/Feature/Requests/Admin/RegisterRequestsTest.php tests/Feature/Requests/Admin/RegisterDateRequestsTest.php tests/Feature/Requests/Homepage/RegisterRequestsTest.php tests/Feature/Requests/Homepage/TutoringRequestsTest.php tests/Feature/Requests/Tutoring/TutoringRequestsTest.php",
        "pretest:ui": "npm run generate:wayfinder",
        "test:ui": "node --disable-warning=ExperimentalWarning --import ./tests/ui/vitest.preload.mjs ./node_modules/vitest/vitest.mjs run --configLoader native --reporter=default",
        "pretest:ui:smoke": "npm run generate:wayfinder",
        "test:ui:smoke": "node --disable-warning=ExperimentalWarning --import ./tests/ui/vitest.preload.mjs ./node_modules/vitest/vitest.mjs run --configLoader native --reporter=default tests/ui/unit/example.test.ts",
        "test:ui:watch": "node --disable-warning=ExperimentalWarning --import ./tests/ui/vitest.preload.mjs ./node_modules/vitest/vitest.mjs --configLoader native",
        "pretest:e2e": "php -r \"if (!copy('.env.e2e.example', '.env.e2e')) { fwrite(STDERR, 'Unable to prepare the E2E environment.' . PHP_EOL); exit(1); } if (!file_exists('database/e2e.sqlite')) { touch('database/e2e.sqlite'); }\" && php artisan key:generate --env=e2e --force --no-interaction && npm run build && php artisan migrate:fresh --env=e2e --seed --seeder=E2eSeeder --force",
        "test:e2e": "playwright test --reporter=line",
        "test:all": "npm run test:php && npm run test:ui",
        "mcp": "ruler apply",
        "mcp:revert": "ruler revert"
    },
    "overrides": {
        "glob": "13.0.6",
        "mute-stream": "3.0.0",
        "shell-quote": "1.10.0",
        "js-beautify": "2.0.3",
        "form-data": "4.0.6",
        "esbuild": "0.28.1"
    },
    "devDependencies": {
        "@intellectronica/ruler": "^0.3.40",
        "@laravel/echo-vue": "^2.3.4",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@pinia/testing": "^1.0.3",
        "@playwright/test": "^1.58.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/vue": "^8.1.0",
        "axios": "^1.15.0",
        "concurrently": "^9.0.1",
        "happy-dom": "^20.6.1",
        "laravel-echo": "^2.3.4",
        "laravel-vite-plugin": "^2.0.0",
        "msw": "^2.13.2",
        "pusher-js": "^8.4.0",
        "vite": "7.3.5",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@tiptap/extension-underline": "^3.30.5",
        "@tiptap/starter-kit": "^3.30.5",
        "@tiptap/vue-3": "^3.30.5",
        "@vitejs/plugin-vue": "^6.0.1",
        "filepond": "^4.32.10",
        "filepond-plugin-file-validate-type": "^1.2.9",
        "filepond-plugin-image-preview": "^4.6.12",
        "laravel-precognition-vue": "^2.0.0",
        "localforage": "^1.10.0",
        "pdfjs-dist": "^4.10.38",
        "pinia": "^3.0.3",
        "puppeteer": "^25.8.0",
        "sass-embedded": "^1.93.2",
        "vite-plugin-vuetify": "^2.1.2",
        "vue": "^3.5.22",
        "vue-filepond": "^7.0.4",
        "vue-router": "^4.6.3",
        "vuetify": "^3.10.5"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "msw@2.15.0": true,
        "puppeteer@25.8.0": true
    }
}
